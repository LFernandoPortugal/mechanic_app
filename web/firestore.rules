rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Users Collection ──────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        (isAdmin() && isSameWorkshop(resource.data))
      );
      allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId && 
          request.resource.data.roles == resource.data.roles && 
          request.resource.data.workshopId == resource.data.workshopId
        ) ||
        isSuperAdmin() ||
        (
          isAdmin() && 
          resource.data.workshopId == getUserData().workshopId && 
          request.resource.data.workshopId == resource.data.workshopId && 
          !request.resource.data.roles.hasAny(['SUPER_ADMIN'])
        )
      );
      allow delete: if request.auth != null && (isSuperAdmin() || (isAdmin() && isSameWorkshop(resource.data) && isResetAllowed(resource.data.workshopId)));
    }

    // ─── Jobs Collection ───────────────────────────────
    match /jobs/{jobId} {
      allow read: if request.auth != null && isSameWorkshop(resource.data);
      allow create: if request.auth != null && (isSuperAdmin() || (request.resource.data.workshopId == getUserData().workshopId && hasAnyRole(['ADMIN', 'RECEPTION'])));
      allow update: if request.auth != null && (isSuperAdmin() || (isSameWorkshop(resource.data) && request.resource.data.workshopId == getUserData().workshopId && (
        isAdmin() || 
        (hasAnyRole(['RECEPTION']) && resource.data.status == 'Reception') ||
        (hasAnyRole(['TECHNICIAN']) && resource.data.status in ['Reception', 'Diagnosis', 'Approved', 'Repair']) ||
        (hasAnyRole(['ADVISOR']))
      )));
      allow delete: if request.auth != null && (isSuperAdmin() || (isAdmin() && isSameWorkshop(resource.data) && isResetAllowed(resource.data.workshopId)));

      allow get: if resource.data.status in ['Approval', 'Approved', 'Repair', 'QC', 'Ready', 'Delivered'];
      allow update: if resource.data.status in ['Approval', 'Ready'] 
                     && request.resource.data.status == 'Approved'
                     && request.resource.data.workshopId == resource.data.workshopId;
    }

    // ─── Inventory Collection ──────────────────────────
    match /inventory/{itemId} {
      allow read: if request.auth != null && (isSuperAdmin() || (isSameWorkshop(resource.data) && hasAnyRole(['ADMIN', 'ADVISOR'])));
      allow create: if request.auth != null && (isSuperAdmin() || (request.resource.data.workshopId == getUserData().workshopId && isAdmin()));
      allow update: if request.auth != null && (isSuperAdmin() || (isSameWorkshop(resource.data) && request.resource.data.workshopId == getUserData().workshopId && isAdmin()));
      allow delete: if request.auth != null && (isSuperAdmin() || (isAdmin() && isSameWorkshop(resource.data) && isResetAllowed(resource.data.workshopId)));
    }

    // ─── Inventory Transactions Collection ─────────────
    match /inventory_transactions/{txId} {
      allow read: if request.auth != null && (isSuperAdmin() || (isSameWorkshop(resource.data) && isAdmin()));
      allow create: if request.auth != null && (isSuperAdmin() || (request.resource.data.workshopId == getUserData().workshopId && hasAnyRole(['ADMIN', 'ADVISOR'])));
      allow update: if request.auth != null && (isSuperAdmin() || (isSameWorkshop(resource.data) && request.resource.data.workshopId == getUserData().workshopId && isAdmin()));
      allow delete: if request.auth != null && (isSuperAdmin() || (isAdmin() && isSameWorkshop(resource.data) && isResetAllowed(resource.data.workshopId)));
    }

    // ─── Settings Collection ───────────────────────────
    match /settings/{documentId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if request.auth != null && (isSuperAdmin() || (isAdmin() && getUserData().workshopId == documentId));
    }

    // ─── Helper Functions ──────────────────────────────
    function hasUserProfile() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isWorkshopActive(workshopId) {
      return workshopId == "demo-workshop" || workshopId == "master-control" || exists(/databases/$(database)/documents/settings/$(workshopId));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSameWorkshop(resourceData) {
      return isSuperAdmin() || (hasUserProfile() && resourceData.workshopId == getUserData().workshopId && isWorkshopActive(resourceData.workshopId));
    }

    function isAdmin() {
      return isSuperAdmin() || (hasUserProfile() && getUserData().roles.hasAny(['ADMIN']));
    }

    function isSuperAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().roles.hasAny(['SUPER_ADMIN']);
    }

    function hasAnyRole(roles) {
      return isSuperAdmin() || (hasUserProfile() && getUserData().roles.hasAny(roles));
    }

    function isResetAllowed(workshopId) {
      return exists(/databases/$(database)/documents/settings/$(workshopId)) && get(/databases/$(database)/documents/settings/$(workshopId)).data.allowResetData == true;
    }
  }
}